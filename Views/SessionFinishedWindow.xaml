<Window x:Class="TaskManager.Views.SessionFinishedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusTask"
        Width="460"
        Height="240"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Время фокус-сессии вышло"
                       FontSize="28"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,25" />

            <Button Content="Закрыть"
                    Height="42"
                    FontSize="18"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
